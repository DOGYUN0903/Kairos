# .env.example — 이 파일을 .env로 복사한 뒤 값을 채운다. (.env는 git에 올리지 않는다)

# MySQL (compose.yaml과 애플리케이션이 같이 사용)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kairos
DB_USERNAME=kairos
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT 서명 키 (256bit 이상, 예: openssl rand -base64 48)
KAIROS_JWT_SECRET=

# 초기 관리자 계정
KAIROS_ADMIN_EMAIL=
KAIROS_ADMIN_PASSWORD=

# Grafana 관리자 비밀번호 (사용자명 admin)
GRAFANA_ADMIN_PASSWORD=

# perf 부하 사용자 비밀번호(8자 이상, 임의 값)
PERF_USER_PASSWORD=


# 업로드 파일 저장 경로와 URL 기준 주소, 선택. 미설정 시 uploads/ 와 http://localhost:8080 사용
# KAIROS_FILE_DIR=uploads
# KAIROS_FILE_BASE_URL=http://localhost:8080
