BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_DEMO_MODE=false
# 데모 모드: true 로 빌드하면 하단 데모 바(역할 전환·데이터 보충)가 켜진다. 비밀번호는 데모 계정(*@kairos.demo) 공용.
# NEXT_PUBLIC_DEMO_PASSWORD=
# NEXT_PUBLIC_DEMO_* 는 로컬·데모 서버에서만 쓴다. 운영 빌드에 두면 데모 계정이 번들에 들어간다.
# 결제 방식: mock(기본) | toss. 백엔드 KAIROS_PG_PROVIDER 와 반드시 같은 값으로 맞춘다. 다르면:
# - 프론트 mock + 백엔드 toss: 승인이 거절되고 주문이 취소된다.
# - 프론트 toss + 백엔드 mock: Mock PG 가 접두사 없는 키를 전부 승인하므로 토스에서 실제 승인 없이 주문이 결제 완료가 된다(로컬에서만 가능한 조합).
NEXT_PUBLIC_PG_PROVIDER=mock
# toss 일 때만: 토스페이먼츠 테스트 "클라이언트 키"(공개용). 시크릿 키는 백엔드 .env 의 TOSS_SECRET_KEY 에만 둔다.
# NEXT_PUBLIC_TOSS_CLIENT_KEY=
